# Auto detect text files and perform LF normalization
* text=auto

# Java files
*.java text eol=lf
*.properties text eol=crlf

# Web assets
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# XML files
*.xml text eol=lf
*.xsd text eol=lf
*.pom text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.jar binary
*.war binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary